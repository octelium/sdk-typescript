{
  "name": "@octelium/sdk",
  "version": "1.1.0",
  "description": "Octelium Typescript SDK",
  "author": "Octelium <contact@octelium.com>",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "examples/*.ts",
    "examples/README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "node --test test/*.test.mjs",
    "check:examples": "tsc -p examples/tsconfig.json",
    "prepack": "npm run build",
    "check:types": "tsc -p tsconfig.check.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/octelium/sdk-typescript.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/octelium/sdk-typescript/issues"
  },
  "homepage": "https://octelium.com",
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@octelium/apis": "^1.0.12",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "typescript": "^5.2.0",
    "@types/node": "^22.0.0"
  },
  "keywords": [
    "octelium",
    "zero-trust",
    "grpc",
    "protobuf",
    "typescript",
    "sdk",
    "cordium"
  ],
  "engines": {
    "node": ">=22"
  }
}
