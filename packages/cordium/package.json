{
  "name": "@octelium/cordium",
  "version": "0.2.0",
  "description": "The Cordium SDK for TypeScript and JavaScript",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./proto": {
      "types": "./dist/proto.d.ts",
      "import": "./dist/proto.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "DESIGN.md",
    "examples/*.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "check:examples": "tsc -p examples/tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.3",
    "@octelium/apis": "^1.0.12",
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/octelium/sdk-typescript.git",
    "directory": "packages/cordium"
  },
  "keywords": [
    "cordium",
    "sandbox",
    "typescript",
    "sdk",
    "workspaces"
  ]
}
