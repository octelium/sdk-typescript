{
  "name": "@octelium/apis",
  "version": "1.0.1",
  "description": "Octelium Protobuf APIs",
  "author": "Octelium <contact@octelium.com>",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./main/*": {
      "import": "./main/*/index.js",
      "types": "./main/*/index.d.ts"
    },
    "./main/*/*": {
      "import": "./main/*/*.js",
      "types": "./main/*/*.d.ts"
    },
    "./google/*": {
      "import": "./google/*.js",
      "types": "./google/*.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "index.js.map",
    "main",
    "google",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/octelium/sdk-typescript.git",
    "directory": "packages/apis"
  },
  "bugs": {
    "url": "https://github.com/octelium/sdk-typescript/issues"
  },
  "homepage": "https://octelium.com",
  "peerDependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "octelium",
    "zero-trust",
    "grpc",
    "protobuf",
    "proto3",
    "typescript",
    "sdk"
  ]
}