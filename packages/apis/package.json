{
  "name": "@octelium/apis",
  "version": "1.0.12",
  "description": "Octelium Protobuf APIs",
  "author": "Octelium <contact@octelium.com>",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./main/metav1": {
      "types": "./dist/main/metav1/index.d.ts",
      "import": "./dist/main/metav1/index.js"
    },
    "./main/corev1": {
      "types": "./dist/main/corev1/index.d.ts",
      "import": "./dist/main/corev1/index.js"
    },
    "./main/authv1": {
      "types": "./dist/main/authv1/index.d.ts",
      "import": "./dist/main/authv1/index.js"
    },
    "./main/userv1": {
      "types": "./dist/main/userv1/index.d.ts",
      "import": "./dist/main/userv1/index.js"
    },
    "./main/cordiumv1": {
      "types": "./dist/main/cordiumv1/index.d.ts",
      "import": "./dist/main/cordiumv1/index.js"
    },
    "./main/metav1/*": {
      "types": "./dist/main/metav1/*.d.ts",
      "import": "./dist/main/metav1/*.js"
    },
    "./main/corev1/*": {
      "types": "./dist/main/corev1/*.d.ts",
      "import": "./dist/main/corev1/*.js"
    },
    "./main/authv1/*": {
      "types": "./dist/main/authv1/*.d.ts",
      "import": "./dist/main/authv1/*.js"
    },
    "./main/userv1/*": {
      "types": "./dist/main/userv1/*.d.ts",
      "import": "./dist/main/userv1/*.js"
    },
    "./main/cordiumv1/*": {
      "types": "./dist/main/cordiumv1/*.d.ts",
      "import": "./dist/main/cordiumv1/*.js"
    },
    "./google/*": {
      "types": "./dist/google/*.d.ts",
      "import": "./dist/google/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/octelium/sdk-typescript.git",
    "directory": "packages/apis"
  },
  "bugs": {
    "url": "https://github.com/octelium/sdk-typescript/issues"
  },
  "homepage": "https://octelium.com",
  "peerDependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "octelium",
    "zero-trust",
    "grpc",
    "protobuf",
    "proto3",
    "typescript",
    "sdk"
  ],
  "scripts": {
    "build": "tsc"
  }
}
