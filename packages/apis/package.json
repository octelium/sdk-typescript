{
  "name": "@octelium/apis",
  "version": "1.0.4",
  "description": "Octelium Protobuf APIs",
  "author": "Octelium <contact@octelium.com>",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./main/metav1": {
      "import": "./main/metav1/index.js",
      "types": "./main/metav1/index.d.ts"
    },
    "./main/corev1": {
      "import": "./main/corev1/index.js",
      "types": "./main/corev1/index.d.ts"
    },
    "./main/authv1": {
      "import": "./main/authv1/index.js",
      "types": "./main/authv1/index.d.ts"
    },
    "./main/userv1": {
      "import": "./main/userv1/index.js",
      "types": "./main/userv1/index.d.ts"
    },
    "./main/cordiumv1": {
      "import": "./main/cordiumv1/index.js",
      "types": "./main/cordiumv1/index.d.ts"
    },
    "./main/metav1/*": {
      "import": "./main/metav1/*.js",
      "types": "./main/metav1/*.d.ts"
    },
    "./main/corev1/*": {
      "import": "./main/corev1/*.js",
      "types": "./main/corev1/*.d.ts"
    },
    "./main/authv1/*": {
      "import": "./main/authv1/*.js",
      "types": "./main/authv1/*.d.ts"
    },
    "./main/userv1/*": {
      "import": "./main/userv1/*.js",
      "types": "./main/userv1/*.d.ts"
    },
    "./main/cordiumv1/*": {
      "import": "./main/cordiumv1/*.js",
      "types": "./main/cordiumv1/*.d.ts"
    },
    "./google/*": {
      "import": "./google/*.js",
      "types": "./google/*.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "index.d.ts.map",
    "index.js.map",
    "main",
    "google",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/octelium/sdk-typescript.git",
    "directory": "packages/apis"
  },
  "bugs": {
    "url": "https://github.com/octelium/sdk-typescript/issues"
  },
  "homepage": "https://octelium.com",
  "peerDependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1"
  },
  "devDependencies": {
    "@protobuf-ts/runtime": "^2.11.1",
    "@protobuf-ts/runtime-rpc": "^2.11.1",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "octelium",
    "zero-trust",
    "grpc",
    "protobuf",
    "proto3",
    "typescript",
    "sdk"
  ]
}